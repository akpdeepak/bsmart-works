# bSmart Works — frontend environment variables
# Copy this file to .env.local and fill in values for your environment.
# .env.local is gitignored — never commit it.
# All Vite env vars must start with VITE_ to be exposed to the browser bundle.

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL for the backend API. The apiClient wrapper prepends this to all requests.
# Local dev: points to the Spring Boot dev server.
# Staging/production: replace with the deployed backend URL.
VITE_API_BASE_URL=http://localhost:8080/api/v1
