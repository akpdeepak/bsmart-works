# Local Docker Compose environment.
# Safe for local development only. Do not use these values for staging or production.

SPRING_PROFILES_ACTIVE=local
POSTGRES_DB=works_db
POSTGRES_USER=bcits_admin
POSTGRES_PASSWORD=works_secure_pass
POSTGRES_PORT=55433
BACKEND_PORT=8090
FRONTEND_PORT=8088
MAILHOG_PORT=8025

BSMART_JWT_SECRET=local-compose-secret-change-before-prod-32-bytes
BSMART_EXPOSE_DEV_VERIFICATION_TOKEN=false
BSMART_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
BSMART_FRONTEND_BASE_URL=http://localhost:8088

# Optional local integrations.
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
