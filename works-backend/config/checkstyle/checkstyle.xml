<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  bSmart Works — Checkstyle rules.
  A deliberately moderate ruleset: enforces consistency without drowning a young
  codebase in noise. Tighten over time. Pair with CLAUDE.md §3 for the architectural
  rules Checkstyle can't express (those live in scripts/guardrails.sh).
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <!-- No tabs for indentation is not enforced (project uses tabs); keep it lenient. -->
  <module name="LineLength">
    <property name="max" value="140"/>
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://"/>
  </module>

  <module name="TreeWalker">
    <!-- Naming consistency (matches the canonical vocabulary in CLAUDE.md §3) -->
    <module name="TypeName"/>
    <!-- Allow underscores in test method names (methodName_scenario_outcome JUnit5 convention).
         Production method names must still be camelCase with no underscores. -->
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
    </module>
    <module name="ConstantName">
      <!-- SLF4J logger fields are conventionally named 'log' or 'logger' (lowercase static final).
           Allow that pattern alongside the standard UPPER_SNAKE_CASE constant convention. -->
      <property name="format" value="^(log|logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
    </module>
    <module name="PackageName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>

    <!-- Imports -->
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport"/>

    <!-- Common correctness / readability -->
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="MissingSwitchDefault"/>
    <module name="OneStatementPerLine">
      <!-- Inline single-line for/while/if bodies are idiomatic Java guard clauses;
           allow them here. Multi-statement lines are still banned. -->
      <property name="treatTryResourcesAsStatement" value="false"/>
    </module>
    <module name="UpperEll"/>
    <!-- NeedBraces: allowSingleLineStatement permits guard clauses like
         `if (x == null) return;` — a common idiomatic pattern that is always safe. -->
    <module name="NeedBraces">
      <property name="allowSingleLineStatement" value="true"/>
      <property name="allowEmptyLoopBody" value="true"/>
    </module>
  </module>
</module>
