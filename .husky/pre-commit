#!/usr/bin/env sh
# bSmart Works — pre-commit gate. Mirrors a subset of CI so violations are caught
# before they ever leave your machine. Edit CLAUDE.md (not the derived files).

# 1. Architecture & brand guardrails (whole repo, fast).
bash scripts/guardrails.sh || exit 1

# 2. AI-rules files stay in sync with CLAUDE.md automatically — regenerate and stage them, so
#    editing CLAUDE.md is the only manual step. (Paths mirror scripts/generate-ai-rules.mjs.)
node scripts/generate-ai-rules.mjs >/dev/null
derived=".github/copilot-instructions.md .windsurfrules AGENTS.md .cursor/rules/bsmart.mdc"
if ! git diff --quiet -- $derived; then
  git add -- $derived
  echo "↻ Synced AI-rules files from CLAUDE.md and staged them."
fi

# 3. Lint staged frontend files (relative paths — robust against spaces in repo path).
staged=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^works-frontend/src/.*\.(js|jsx)$' \
  | sed 's#^works-frontend/##')
if [ -n "$staged" ]; then
  if [ -d works-frontend/node_modules ]; then
    ( cd works-frontend && npx eslint $staged ) || exit 1
  else
    echo "skip eslint (works-frontend/node_modules missing — run 'npm ci' there)"
  fi
fi
