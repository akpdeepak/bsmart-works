<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.bcits</groupId>
	<artifactId>works</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<jjwt.version>0.13.0</jjwt.version>
		<testcontainers.version>1.20.4</testcontainers.version>
	</properties>

	<!-- The Spring Boot 4.0 parent does not manage the raw org.testcontainers:* artifact versions,
	     so import the Testcontainers BOM to align postgresql + junit-jupiter (test-only). -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- TOTP / MFA -->
		<dependency>
			<groupId>com.eatthepath</groupId>
			<artifactId>java-otp</artifactId>
			<version>0.4.0</version>
		</dependency>

		<!-- Email notifications -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- ArchUnit: architecture boundary gate (module + layering rules) — see ArchitectureTest.
		     Pure static bytecode analysis; runs as a @Tag("unit") test (no Spring context, no DB). -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.4.2</version>
			<scope>test</scope>
		</dependency>
		<!-- Actuator: /actuator/health and /actuator/info for liveness/readiness probes -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Testcontainers: the DB/Flyway CI stage. Boots the app against a real Postgres so every
		     migration is applied end-to-end (catches dup versions / bad SQL the unit jobs cannot).
		     Versions are managed by the Spring Boot parent BOM. Used only by *IntegrationTest. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- OpenAPI 3.1 / Swagger UI — auto-generates docs from Spring controllers.
		     Served at /api-docs (JSON) and /swagger-ui.html (browser UI) at runtime.
		     See OpenApiConfig for the bearer-auth scheme and global metadata. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- JaCoCo: coverage instrumentation, reporting, and an enforced gate.
			     The check runs in the verify phase. The CI backend-unit-test job runs
			     `./mvnw -Dgroups=unit verify` so coverage is measured against unit tests only
			     (no live DB required). The compile+checkstyle job skips JaCoCo via
			     -Djacoco.skip=true so that `-DskipTests verify` does not report 0% coverage.
			     Minimum: 60% LINE coverage on the BUNDLE (all @Tag("unit") tests combined). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>jacoco-prepare</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
						<configuration>
							<haltOnFailure>true</haltOnFailure>
							<!-- Exclude Spring-managed beans, JPA entities, and DTOs.
							     Only pure utility/domain classes (ApiError, ApiException,
							     PageResponse, JwtUtil, GlobalExceptionHandler) are measured.
							     Everything else requires a live DB or Spring context and belongs
							     in integration tests. -->
							<excludes>
								<exclude>**/*Controller.class</exclude>
								<exclude>**/*Repository.class</exclude>
								<exclude>**/*Service.class</exclude>
								<exclude>**/*Scheduler.class</exclude>
								<exclude>**/*Filter.class</exclude>
								<exclude>**/*Config.class</exclude>
								<exclude>**/WorksApplication.class</exclude>
								<exclude>**/DemoApplication.class</exclude>
								<exclude>**/AuthenticatedUser.class</exclude>
								<exclude>**/dto/**</exclude>
								<exclude>**/ActionItem.class</exclude>
								<exclude>**/AppEvent.class</exclude>
								<exclude>**/Article.class</exclude>
								<exclude>**/ArticleComment.class</exclude>
								<exclude>**/ArticleVersion.class</exclude>
								<exclude>**/Assumption.class</exclude>
								<exclude>**/Comment.class</exclude>
								<exclude>**/CrossProjectDependency.class</exclude>
								<exclude>**/Dashboard.class</exclude>
								<exclude>**/DashboardWidget.class</exclude>
								<exclude>**/Decision.class</exclude>
								<exclude>**/Dependency.class</exclude>
								<exclude>**/FieldDef.class</exclude>
								<exclude>**/FieldLayout.class</exclude>
								<exclude>**/FieldVisibility.class</exclude>
								<exclude>**/KnowledgeSpace.class</exclude>
								<exclude>**/LessonLearned.class</exclude>
								<exclude>**/Meeting.class</exclude>
								<exclude>**/MeetingNote.class</exclude>
								<exclude>**/Notification.class</exclude>
								<exclude>**/PermissionScheme.class</exclude>
								<exclude>**/PmIssue.class</exclude>
								<exclude>**/Project.class</exclude>
								<exclude>**/Release.class</exclude>
								<exclude>**/Risk.class</exclude>
								<exclude>**/RoleDef.class</exclude>
								<exclude>**/RolePermission.class</exclude>
								<exclude>**/SavedFilter.class</exclude>
								<exclude>**/Sprint.class</exclude>
								<exclude>**/Stakeholder.class</exclude>
								<exclude>**/User.class</exclude>
								<exclude>**/WorkItem.class</exclude>
								<exclude>**/WorkItemFieldValue.class</exclude>
								<exclude>**/WorkItemLink.class</exclude>
								<exclude>**/WorkLog.class</exclude>
								<exclude>**/Workflow.class</exclude>
								<exclude>**/WorkflowStatus.class</exclude>
								<exclude>**/WorkflowTransition.class</exclude>
								<exclude>**/Workspace.class</exclude>
								<exclude>**/CustomDomain.class</exclude>
								<exclude>**/WorkItemTypeConfig.class</exclude>
								<!-- Iteration 14 (developer workspace) entities -->
								<exclude>**/PullRequest.class</exclude>
								<exclude>**/PullRequestReviewer.class</exclude>
								<exclude>**/CodeLink.class</exclude>
								<exclude>**/FocusBlock.class</exclude>
								<exclude>**/DodChecklist.class</exclude>
								<exclude>**/DodChecklistItem.class</exclude>
								<exclude>**/DodChecklistState.class</exclude>
								<!-- Iteration 9 (service management) entities -->
								<exclude>**/CustomerAccount.class</exclude>
								<exclude>**/CustomerUser.class</exclude>
								<exclude>**/RequestType.class</exclude>
								<exclude>**/ServiceRequest.class</exclude>
								<exclude>**/CsatResponse.class</exclude>
								<exclude>**/CustomerSlaTier.class</exclude>
								<exclude>**/SlaCalendar.class</exclude>
								<exclude>**/SlaPolicy.class</exclude>
								<exclude>**/SlaTarget.class</exclude>
								<exclude>**/SlaInstance.class</exclude>
								<exclude>**/SlaEscalation.class</exclude>
								<!-- Iteration 12 (KPI framework) entities -->
								<exclude>**/MetricDefinition.class</exclude>
								<exclude>**/MetricSnapshot.class</exclude>
								<exclude>**/MetricShare.class</exclude>
								<!-- Iteration 13 (automation + integrations) entities -->
								<exclude>**/AutomationRule.class</exclude>
								<exclude>**/AutomationRun.class</exclude>
								<exclude>**/WebhookSubscription.class</exclude>
								<exclude>**/WebhookDelivery.class</exclude>
								<exclude>**/IntegrationConnection.class</exclude>
								<exclude>**/ApiToken.class</exclude>
								<!-- Iteration 19 (enterprise security) entities. The security *logic*
								     (AuditHashChain, ConditionalAccessEvaluator, AnomalyDetector,
								     WebAuthnCrypto) is pure and IS measured by unit tests. -->
								<exclude>**/WebAuthnCredential.class</exclude>
								<exclude>**/WebAuthnChallenge.class</exclude>
								<exclude>**/ConditionalAccessPolicy.class</exclude>
								<exclude>**/WorkspaceSecuritySettings.class</exclude>
								<exclude>**/AuditLogEntry.class</exclude>
								<exclude>**/AuditLogStreamConfig.class</exclude>
								<exclude>**/AccessAnomaly.class</exclude>
								<exclude>**/DataSubjectRequest.class</exclude>
								<exclude>**/ComplianceEvidenceBundle.class</exclude>
								<exclude>**/PentestEngagement.class</exclude>
							</excludes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.60</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Surefire: when running unit tests only (./mvnw -B -Dgroups=unit test),
			     skip integration tests that need a live database. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*IntegrationTest.java</exclude>
						<exclude>**/*IT.java</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!-- Failsafe: runs *IntegrationTest classes (Testcontainers-backed). Invoked explicitly by
			     the CI `backend-integration-test` job via
			     `./mvnw test-compile failsafe:integration-test failsafe:verify` (Docker required, so it
			     does NOT run in the unit/compile jobs). In the unit job's `verify`, the JUnit group
			     filter (-Dgroups=unit) excludes the @Tag("integration") classes, so no container starts. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*IntegrationTest.java</include>
						<include>**/*IT.java</include>
					</includes>
					<systemPropertyVariables>
						<!-- docker-java (under Testcontainers 1.20.x) defaults to Docker API 1.32,
						     which engines ≥ 29 reject (min 1.40) with an opaque 400. Pin a version
						     every supported engine speaks: CI runners (Docker 26/27) and current
						     Docker Desktop both accept 1.44. Drop when Testcontainers is bumped to
						     a docker-java that negotiates. -->
						<api.version>1.44</api.version>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Checkstyle: enforces Java style consistency across all contributors and AI tools.
			     Runs at the `verify` phase (so CI catches it). TD-005 (2026-06-08): baseline
			     is now clean — failOnViolation is true so any new violation blocks CI.
			     Config: config/checkstyle/checkstyle.xml -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<configLocation>config/checkstyle/checkstyle.xml</configLocation>
					<consoleOutput>true</consoleOutput>
					<failOnViolation>true</failOnViolation>
					<violationSeverity>warning</violationSeverity>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-verify</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
