# bSmart Works — backend environment variables
# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit it.
# All variables follow the BSMART_* prefix convention (CLAUDE.md §8).
# The Spring Boot app falls back to the defaults in application.properties when a variable
# is not set — those defaults are safe only for local development.

# ── Database ──────────────────────────────────────────────────────────────────
BSMART_DB_URL=jdbc:postgresql://localhost:5432/works_db
BSMART_DB_USERNAME=bcits_admin
BSMART_DB_PASSWORD=works_secure_pass

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST be overridden in staging and production with a 32+ char random string.
# Generate: openssl rand -base64 48
BSMART_JWT_SECRET=dev-only-change-me-bSmartWorksSecretKey2026

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Never use * outside local development.
BSMART_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Dev tooling ───────────────────────────────────────────────────────────────
# Exposes the email verification token in the registration API response so local
# development works without a real inbox. MUST be false in staging and production.
BSMART_EXPOSE_DEV_VERIFICATION_TOKEN=true

# ── ClamAV (virus scanning) ───────────────────────────────────────────────────
# Points to the ClamAV container from docker-compose.yml.
# On Linux: use localhost. On WSL2: run `wsl hostname -I` to get the WSL2 IP.
BSMART_CLAMAV_HOST=localhost
BSMART_CLAMAV_PORT=3310

# HikariCP connection pool (optional overrides — defaults are fine for local dev)
# BSMART_DB_POOL_MAX=10
# BSMART_DB_POOL_MIN_IDLE=2
