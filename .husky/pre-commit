#!/usr/bin/env sh
# bSmart Works — pre-commit gate. Mirrors a subset of CI so violations are caught
# before they ever leave your machine. Edit ai-rules/ (not the derived files).

# 1. Architecture & brand guardrails (whole repo, fast).
bash scripts/guardrails.sh || exit 1

# 2. AI-rules files must stay in sync with CLAUDE.md.
node scripts/generate-ai-rules.mjs --check || {
  echo "AI rules are stale. Run: node scripts/generate-ai-rules.mjs  then re-stage."
  exit 1
}

# 3. Every task keeps the scope/plan/acceptance/validation + TDD contract.
node scripts/check-task-execution-contract.mjs || exit 1

# 4. DoD version tag: CLAUDE.md §4 and PR template must carry the same tag.
bash scripts/check-dod-sync.sh || exit 1

# 5. Lint staged frontend files (relative paths — robust against spaces in repo path).
staged=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^works-frontend/src/.*\.(js|jsx)$' \
  | sed 's#^works-frontend/##')
if [ -n "$staged" ]; then
  if [ -d works-frontend/node_modules ]; then
    ( cd works-frontend && npx eslint $staged ) || exit 1
  else
    echo "skip eslint (works-frontend/node_modules missing — run 'npm ci' there)"
  fi
fi
