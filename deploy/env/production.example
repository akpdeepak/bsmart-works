# Production environment template.
# Copy to a private .env file, fill every required value, and never commit the filled file.

SPRING_PROFILES_ACTIVE=prod
POSTGRES_DB=works_db
POSTGRES_USER=bsmart_app
POSTGRES_PASSWORD=
POSTGRES_PORT=55433
BACKEND_PORT=8090
FRONTEND_PORT=8088
MAILHOG_PORT=8025

BSMART_JWT_SECRET=
BSMART_EXPOSE_DEV_VERIFICATION_TOKEN=false
BSMART_CORS_ALLOWED_ORIGINS=https://app.example.com
BSMART_FRONTEND_BASE_URL=https://app.example.com
APP_ATTACHMENTS_DIR=/data/uploads

# Production integrations and encryption.
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
